# Copy to deploy/production.env; never commit the real environment file.
# Replace with the digest printed by the Container image workflow. No image is
# published until a maintainer runs that workflow with publish enabled or releases.
MTL_IMAGE=ghcr.io/YOUR-OWNER/YOUR-REPOSITORY@sha256:REPLACE_WITH_PUBLISHED_DIGEST
MTL_DOMAIN=trade.example.com
ACME_EMAIL=operator@example.com
MTL_MAX_ACCOUNTS=10000
MTL_DATA_VOLUME=mtl-production-data
